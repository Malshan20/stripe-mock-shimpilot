# Local app: Node.js 24 LTS. Leave DEMO_MODE=true for zero-key operation.
APP_URL=http://localhost:3000
DEMO_MODE=true
DATABASE_PATH=.data/demo.sqlite
# Required when DEMO_MODE=false; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Provider modes are independent. Set DEMO_MODE=false to allow remote modes.
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Historical API version is deliberately literal in src/lib/providers/stripe.ts.
OPENAI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPABASE_MODE=mock
SUPABASE_URL=
# Use legacy anon JWT for compatibility with the intentionally old v1 SDK.
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=demo-files
# Anthropic's retired-model case is mock-only by default.
ANTHROPIC_MODE=mock
ANTHROPIC_API_KEY=
# AWS cloud export is mock-only by default. AWS has no Stripe-like sandbox.
AWS_MODE=mock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
